---
import BaseLayout from "../layouts/BaseLayout.astro";

const focus = ["JavaScript", "TypeScript", "Node.js", "React"];

// More to follow — just append here.
const projects = [
  {
    name: "Kino Weltspiegel Cottbus",
    kicker: "gh/weltspiegel-cottbus",
    description:
      "Relaunch des Kino-Webauftritts: eigene Komponenten für Spielplan, Veranstaltungen, eingebettete Videos und Cookie-Consent.",
    links: [
      { label: "Code ansehen", url: "https://github.com/weltspiegel-cottbus" },
    ],
  },
  {
    name: "Online-Prüfungstool",
    kicker: "onlinex.lean-stack.rocks",
    description:
      "Online-Prüfungen: Lehrende stellen Multiple-Choice- und offene Fragen zusammen, Studierende nehmen per Zugangscode und Timer teil.",
    links: [
      { label: "Website ansehen", url: "https://onlinex.lean-stack.rocks/" },
    ],
  },
  {
    name: "Linux-Schulungsunterlagen",
    kicker: "gh/lean-stack/linux-docs",
    description:
      "Dokumentation für meine Linux-Schulungen, gebaut mit Astro Starlight.",
    links: [
      { label: "Website ansehen", url: "https://linux.lean-stack.rocks/" },
      {
        label: "Code ansehen",
        url: "https://github.com/lean-stack/linux-docs",
      },
    ],
  },
  {
    name: "runde.tips",
    kicker: "gh/haus23/tipprunde",
    description:
      "Tipprunde für Fußball-Vorhersagen im Freundeskreis — mein privates Nebenprojekt.",
    links: [
      { label: "Website ansehen", url: "https://runde.tips" },
      { label: "Code ansehen", url: "https://github.com/haus23/tipprunde" },
      {
        label: "Legacy-Code",
        url: "https://github.com/haus23/tipprunde-legacy",
      },
    ],
  },
];
---

<BaseLayout>
  <div class="mx-auto max-w-3xl">
    <section class="pt-10 pb-16 sm:pt-16 sm:pb-20">
      <p class="font-mono text-sm text-muted">
        // Softwareentwickler & Trainer · Cottbus
      </p>

      <h1
        class="mt-4 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl md:text-6xl"
      >
        Michael Buchholz
      </h1>
      <p class="mt-2 font-mono text-lg text-add">Lean Code!</p>

      <div
        class="mt-8 overflow-hidden rounded-md border border-hairline bg-surface font-mono text-sm leading-relaxed shadow-sm"
      >
        <p
          class="border-l-2 border-del bg-del-soft px-4 py-1.5 text-del before:mr-2 before:content-['−']"
        >
          40 Frameworks für ein Kontaktformular
        </p>
        <p
          class="border-l-2 border-del bg-del-soft px-4 py-1.5 text-del before:mr-2 before:content-['−']"
        >
          Meetings über das Meeting davor
        </p>
        <p
          class="border-l-2 border-add bg-add-soft px-4 py-1.5 text-add before:mr-2 before:content-['+']"
        >
          TypeScript, das hält, was es verspricht
        </p>
        <p
          class="border-l-2 border-add bg-add-soft px-4 py-1.5 text-add before:mr-2 before:content-['+']"
        >
          Node.js im Rücken, React im Blick
        </p>
      </div>

      <p class="mt-8 max-w-xl text-base leading-relaxed text-ink/80">
        Ich entwickle Web-Anwendungen mit JavaScript und TypeScript — im
        Backend mit Node.js, im Frontend mit React. Klar strukturierter Code
        statt Ballast: gut wartbar, gut testbar, schnell im Einsatz — und gut
        erklärbar. Denn genauso, wie ich entwickle, gebe ich Schulungen dazu.
      </p>
      <p class="mt-3 font-mono text-sm text-muted">
        // 50 % Entwicklung · 50 % Training
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="mailto:mail@michael-buchholz.com"
          class="rounded-md bg-ink px-5 py-2.5 font-medium text-white transition-colors hover:bg-add focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-add"
        >
          Projekt besprechen
        </a>
        <ul class="flex flex-wrap gap-2 font-mono text-xs text-muted">
          {
            focus.map((item) => (
              <li class="rounded border border-hairline px-2 py-1">{item}</li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="border-t border-hairline py-12">
      <h2 class="font-display text-xl font-semibold text-ink">
        Aktuelle Arbeiten
      </h2>
      <div class="mt-6 space-y-4">
        {
          projects.map((project) => (
            <div class="rounded-lg border border-hairline bg-surface p-5 transition-colors has-[a:hover]:border-add has-[a:focus-visible]:border-add">
              <p class="font-mono text-xs text-muted">{project.kicker}</p>
              <h3 class="mt-1 font-display text-lg font-semibold text-ink">
                {project.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">
                {project.description}
              </p>
              <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs">
                {project.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-add underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-add"
                  >
                    {link.label} ↗
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
