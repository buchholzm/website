---
import "../styles/global.css";

const { title = "Michael Buchholz — Lean Code" } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { label: "Home", href: "/", active: path === "/" },
  {
    label: "Schulungen",
    href: "/schulungen",
    // The setup pages belong to the training area.
    active: path === "/schulungen" || path.startsWith("/training"),
  },
];
---

<html lang="de" class="h-full">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>

<body class="h-full bg-paper font-sans text-ink">
  <div class="h-full flex flex-col">
    <nav class="shrink-0 px-4 h-16 flex justify-end items-center gap-4">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class:list={[
              "border-b-2 font-medium transition-colors hover:text-ink",
              item.active
                ? "border-add text-ink"
                : "border-transparent text-muted",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <main class="grow p-4">
      <slot />
    </main>
    <footer class="shrink-0 h-16 flex flex-col sm:flex-row items-center justify-center gap-x-2 border-t border-hairline text-sm text-muted">
      <span>© 2026 Michael Buchholz</span>
      <span class="hidden sm:block">·</span>
      <a class="border-b border-transparent transition-colors hover:border-muted" href="/impressum">Impressum und Datenschutzerklärung</a>
    </footer>
  </div>
</body>

</html>
